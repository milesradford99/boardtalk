{
  "name": "boardtalk-workspace",
  "private": true,
  "description": "boardtalk: a live, append-only canvas of what an AI agent did, kept as a durable artifact.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesradford99/boardtalk.git"
  },
  "homepage": "https://github.com/milesradford99/boardtalk#readme",
  "bugs": {
    "url": "https://github.com/milesradford99/boardtalk/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
